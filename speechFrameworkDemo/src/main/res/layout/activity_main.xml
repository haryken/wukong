<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".MainActivity">

  <TextView
      android:id="@+id/activation_code"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:textSize="28sp"
      android:textStyle="bold"
      android:visibility="gone"
      android:text="---" />

  <TextView
      android:id="@+id/device_id"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textSize="14sp"
      android:fontFamily="monospace"
      android:text="token: ---" />

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:text="@string/transport_label"
      android:textSize="14sp"
      android:textStyle="bold" />

  <RadioGroup
      android:id="@+id/transport_group"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">

    <RadioButton
        android:id="@+id/rb_transport_websocket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/transport_websocket" />

    <RadioButton
        android:id="@+id/rb_transport_mqtt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/transport_mqtt" />
  </RadioGroup>

  <TextView
      android:id="@+id/transport_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:gravity="center"
      android:textSize="12sp"
      android:textColor="#666666"
      android:text="" />

  <TextView
      android:id="@+id/client_id"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:text="---" />

  <TextView
      android:id="@+id/tv_background_hint"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:gravity="center"
      android:textSize="12sp"
      android:textColor="#888888" />

</LinearLayout>
